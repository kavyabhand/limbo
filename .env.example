# Copy to .env.local for local development. Never commit real values.

# Nexconn Console → your app → App Key / App Secret (Singapore data center).
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Server API domains for the app's data center (these are Singapore's).
NEXCONN_API_PRIMARY=api.sg-light-api.com
NEXCONN_API_BACKUP=api-b.sg-light-api.com

# Postgres (local: postgres://localhost/limbo, production: Neon pooled URL).
DATABASE_URL=postgres://localhost/limbo

# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=

# Ed25519 private key (PKCS#8 DER, base64) that signs live card state:
#   node -e "const {generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
STATE_SIGNING_KEY=

# Protects the private traction dashboard and admin endpoints: openssl rand -hex 24
ADMIN_KEY=

APP_URL=http://localhost:3000
