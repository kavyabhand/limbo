{
  "name": "limbo",
  "version": "0.1.0",
  "private": true,
  "description": "Trip stuck in limbo? A live room for everyone on the same flight, train or bus. Built on the Nexconn Chat SDK.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/migrate.ts",
    "e2e": "node tests/e2e/run-all.mjs",
    "e2e:api": "node tests/e2e/api.mjs",
    "e2e:live": "node tests/e2e/live-room.mjs",
    "e2e:offline": "node tests/e2e/offline.mjs",
    "e2e:demo": "node tests/e2e/demo-journey.mjs",
    "bench": "node tests/bench/bench.mjs"
  },
  "dependencies": {
    "@nexconn/chat": "26.2.1",
    "@nexconn/engine": "26.2.1",
    "@noble/ed25519": "^3.2.0",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
